# Copy to .env and choose your own values. Single quotes keep $ and # literal.
DB_PASSWORD=''
SPRING_SECURITY_USER_NAME=operator
SPRING_SECURITY_USER_PASSWORD=''
# Optional additional accounts. Blank passwords leave new accounts unprovisioned.
CLINICFLOW_VIEWER_USERNAME=viewer
CLINICFLOW_VIEWER_PASSWORD=''
CLINICFLOW_ADMIN_USERNAME=admin
CLINICFLOW_ADMIN_PASSWORD=''
# Only fictional department/ward/bed records; no patients are generated.
CLINICFLOW_DEMO_DATA_ENABLED=true
CLINICFLOW_TIME_ZONE=UTC
APP_PORT=8080
POSTGRES_PORT=5432
# Enable only when the browser reaches the application through HTTPS.
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
